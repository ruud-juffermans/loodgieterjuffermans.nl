# Loodgietersbedrijf Juffermans - Apache config for the prerendered build.
# Every route is a static HTML file (dist/diensten/zinkwerk.html and
# dist/diensten/zinkwerk/index.html), so no SPA fallback is needed.
Options -MultiViews -Indexes
RewriteEngine On

# Canonical host: always www over https
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.loodgieterjuffermans.nl%{REQUEST_URI} [R=301,L]

# Pages from the previous site that no longer exist

# /diensten/zinkwerk -> /diensten/zinkwerk.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
RewriteRule ^(.+)$ $1.html [L]

# Anything else is a real 404
ErrorDocument 404 /404.html

# Hashed build assets never change: cache for a year
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|webp|jpe?g|png|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|txt|json|xml)$">
    Header set Cache-Control "public, max-age=600"
  </FilesMatch>
</IfModule>

# Plain-text and JSON discovery files (llms.txt, agent-permissions.json)
# as UTF-8 so Dutch characters are read correctly by AI crawlers.
<IfModule mod_mime.c>
  AddCharset UTF-8 .txt .json
</IfModule>
